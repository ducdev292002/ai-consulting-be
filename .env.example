PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_sales_assistant
OPENAI_API_KEY=sk-your-key-here

# Model phải hỗ trợ web_search trong Responses API (gpt-4o-mini KHÔNG hỗ trợ)
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Đặt false để tắt tìm kiếm web (web search tốn ~$10/1000 lần gọi)
ENABLE_WEB_SEARCH=true

CLIENT_ORIGIN=http://localhost:5173
